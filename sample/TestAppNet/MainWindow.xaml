<Window x:Class="TestAppNet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestAppNet"
                ResizeMode="NoResize" Background="Black"
        mc:Ignorable="d" Loaded="Window_Loaded" Closing="Window_Closing"
        Title="Image View" Height="450" Width="800">
    <Grid>
        <DockPanel LastChildFill="true">
            <Grid DockPanel.Dock="Right" Width="200" x:Name="GridSideView">
                <Label Content="Counter" Foreground="Teal" HorizontalAlignment="Left" HorizontalContentAlignment="Right" Margin="15,10,0,0" VerticalAlignment="Top" Width="104" Padding="5,2,5,2"/>
                <Label Content="{Binding Counter,UpdateSourceTrigger=PropertyChanged}" Foreground="LightCyan" HorizontalAlignment="Left" Margin="119,10,0,0" VerticalAlignment="Top" Width="77" Padding="5,2,5,2" Height="20"/>
                <Label Content="Min-Intensity-Ref" Foreground="Teal" HorizontalAlignment="Left" HorizontalContentAlignment="Right" Margin="0,30,0,0" VerticalAlignment="Top" Width="119" Padding="5,2,5,2"/>
                <Label Content="{Binding DataMin, UpdateSourceTrigger=PropertyChanged}" Foreground="LightCyan" HorizontalAlignment="Left" Margin="119,30,0,0" VerticalAlignment="Top" Width="77" Padding="5,2,5,2" Height="20"/>
                <Label Content="Max-Intensity-Ref" Foreground="Teal" HorizontalAlignment="Left" HorizontalContentAlignment="Right" Margin="0,50,0,0" VerticalAlignment="Top" Width="119" Padding="5,2,5,2"/>
                <Label Content="{Binding DataMax, UpdateSourceTrigger=PropertyChanged}" Foreground="LightCyan" HorizontalAlignment="Left" Margin="119,50,0,0" VerticalAlignment="Top" Width="77" Padding="5,2,5,2" Height="20"/>
                <Button x:Name="BtnStart" Content="Start" HorizontalAlignment="Left" Margin="15,85,0,0" VerticalAlignment="Top" Height="24" Width="60" Click="BtnStart_Click"/>
                <Button x:Name="BtnStop" Content="Stop" HorizontalAlignment="Left" Margin="85,85,0,0" VerticalAlignment="Top" Height="24" Width="60" Click="BtnStop_Click"/>

            </Grid>
            <Grid DockPanel.Dock="Left">
                <Border Margin="10" >
                    <Image x:Name="ImageView" Margin="0,0,0,0" Stretch="Uniform"/>
                </Border>

                <ComboBox Name="ColorMappingsSelection" IsEditable="False" Margin="20" HorizontalAlignment="Right" Grid.Column="1" VerticalAlignment="Bottom" Grid.Row="1" Width="120"  
                  SelectionChanged="PaletteSelectionChanged">

                </ComboBox>
            </Grid>
        </DockPanel>

    </Grid>
</Window>
