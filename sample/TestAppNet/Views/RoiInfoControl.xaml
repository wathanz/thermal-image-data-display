<UserControl x:Class="DemoAppNet.RoiInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DemoAppNet"
             BorderBrush="Teal"
             mc:Ignorable="d"
             BorderThickness="0,0,0,1"
             Background="LightGray"
             d:DesignHeight="22"
             d:DesignWidth="550">
    <Grid>
        <TextBox x:Name="TxtTopEntry"
                 HorizontalAlignment="Left"
                 TextWrapping="Wrap"
                 BorderThickness="0"
                 Text="{Binding Top, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                 VerticalAlignment="Center"
                 Width="30"
                 Margin="87,0,0,0"
                 KeyUp="TxtTopEntry_KeyUp"
                 VerticalContentAlignment="Center" />
        <Label Content="{Binding Id}"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Padding="5,0,5,0"
               Width="52"
               VerticalContentAlignment="Center"
               Height="15"
               Margin="3,0,0,0" />
        <CheckBox Content="👀"
                  HorizontalAlignment="Left"
                  Margin="191,0,0,0"
                  IsChecked="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                  VerticalAlignment="Center"
                  Height="NaN" />
        <TextBox x:Name="TxtColorEntry"
                 HorizontalAlignment="Left"
                 TextWrapping="Wrap"
                 BorderThickness="0"
                 Text="{Binding ColorString, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                 VerticalAlignment="Center"
                 Width="74"
                 Margin="239,0,0,0"
                 VerticalContentAlignment="Center"
                 KeyUp="TxtColorEntry_KeyUp" />
        <TextBox x:Name="TxtThicknessEntry"
                 HorizontalAlignment="Left"
                 TextWrapping="Wrap"
                 BorderThickness="0"
                 Text="{Binding Thickness, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                 VerticalAlignment="Center"
                 Width="22"
                 Margin="317,0,0,0"
                 KeyUp="TxtThicknessEntry_KeyUp"
                 VerticalContentAlignment="Center" />
        <Button x:Name="BtnRemove"
                Content="Remove"
                Margin="493,0,0,0"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                Width="54"
                Click="BtnRemove_Click" />
        <TextBox x:Name="TxtLeftEntry"
                 HorizontalAlignment="Left"
                 TextWrapping="Wrap"
                 BorderThickness="0"
                 Text="{Binding Left, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Center"
                 Width="30"
                 Margin="55,0,0,0"
                 VerticalContentAlignment="Center"
                 KeyUp="TxtLeftEntry_KeyUp" />
        <TextBox x:Name="TxtWidthEntry"
                 HorizontalAlignment="Left"
                 TextWrapping="Wrap"
                 BorderThickness="0"
                 Text="{Binding Width, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Center"
                 Width="30"
                 Margin="124,0,0,0"
                 KeyUp="TxtWidthEntry_KeyUp"
                 VerticalContentAlignment="Center" />
        <TextBox x:Name="TxtHeightEntry"
                 HorizontalAlignment="Left"
                 TextWrapping="Wrap"
                 BorderThickness="0"
                 Text="{Binding Height, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Center"
                 Width="30"
                 Margin="156,0,0,0"
                 KeyUp="TxtHeightEntry_KeyUp"
                 VerticalContentAlignment="Center" />
        <TextBox x:Name="TxtTextTop"
                 HorizontalAlignment="Left"
                 TextWrapping="Wrap"
                 BorderThickness="0"
                 Text="{Binding TextOnTop, Mode=OneWay}"
                 VerticalAlignment="Center"
                 Width="43"
                 Margin="388,0,0,0"
                 VerticalContentAlignment="Center"
                 KeyUp="TxtTextTop_KeyUp" />
        <TextBox x:Name="TxtTextBottom"
                 HorizontalAlignment="Left"
                 TextWrapping="Wrap"
                 BorderThickness="0"
                 VerticalAlignment="Center"
                 Text="{Binding TextOnBottom, Mode=OneWay}"
                 Width="48"
                 Margin="436,0,0,0"
                 VerticalContentAlignment="Center"
                 KeyUp="TxtTextBottom_KeyUp" />
        <Label Content="Text"
               HorizontalAlignment="Left"
               Margin="357,0,0,0"
               VerticalAlignment="Center"
               Padding="5,1,5,1" />

    </Grid>
</UserControl>
