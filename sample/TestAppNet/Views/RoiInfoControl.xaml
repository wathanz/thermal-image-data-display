<UserControl x:Class="DemoAppNet.RoiInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DemoAppNet"
             BorderBrush="Teal"
             mc:Ignorable="d" BorderThickness="0,0,0,1"
             d:DesignHeight="22"
             d:DesignWidth="400">
    <Grid>
        <TextBox HorizontalAlignment="Left"
                 TextWrapping="Wrap"
                 BorderThickness="0"
                 Text="20, 40, 100, 400"
                 VerticalAlignment="Center"
                 Width="94"
                 Margin="46,0,0,0"
                 VerticalContentAlignment="Center" />
        <Label Content="roi-1"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Padding="5,0,5,0"
               Width="41"
               VerticalContentAlignment="Center" />
        <CheckBox Content="Hide"
                  HorizontalAlignment="Left"
                  Margin="150,0,0,0"
                  VerticalAlignment="Center"
                  Height="NaN" />
        <TextBox HorizontalAlignment="Left"
                 TextWrapping="Wrap"
                 BorderThickness="0"
                 Text="#FF5733"
                 VerticalAlignment="Center"
                 Width="55"
                 Margin="209,0,0,0"
                 VerticalContentAlignment="Center" />
        <TextBox HorizontalAlignment="Left"
                 TextWrapping="Wrap"
                 BorderThickness="0"
                 Text="2"
                 VerticalAlignment="Center"
                 Width="21"
                 Margin="274,0,0,0"
                 VerticalContentAlignment="Center" />
        <Button Content="Remove"
                Margin="344,0,0,0"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                Width="54" />

    </Grid>
</UserControl>
