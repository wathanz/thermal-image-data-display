<UserControl x:Class="WpfIntensityView.Views.ImageViewUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfIntensityView.Views"
             xmlns:drawingLib="clr-namespace:WpfCanvasDrawing;assembly=WpfCanvasDrawing"
             Loaded="UserControl_Loaded"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="GrdImageView"
          Margin="0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ClipToBounds="True"
          MouseDown="GrdImageView_MouseDown"
          SizeChanged="GrdImageView_SizeChanged">
        <Grid Name="GrdDrawContainer"
              Margin="0" HorizontalAlignment="Left" VerticalAlignment="Top"
              MouseWheel="GrdDrawContainer_MouseWheel">
            <Image Name="ImageHost"
                   Stretch="None"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
            <drawingLib:DrawingCanvas x:Name="OverlayCanvas"></drawingLib:DrawingCanvas>
        </Grid>
        <TextBlock VerticalAlignment="Top"
               HorizontalAlignment="Right"
                   Background="#7F0000FF"
                   ToolTip="FPS"
                   Text="{Binding Fps, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}"
               Foreground="White"
               TextAlignment="Right"
               Width="25"
               Padding="2"></TextBlock>
    </Grid>
</UserControl>
