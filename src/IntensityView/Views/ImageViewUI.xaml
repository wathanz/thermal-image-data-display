<UserControl x:Class="IntensityView.Views.ImageViewUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IntensityView.Views" 
             xmlns:drawingLib="clr-namespace:DrawingLib"
             Loaded="UserControl_Loaded"
             mc:Ignorable="d" Unloaded="UserControl_Unloaded"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="GrdImageView"
          DockPanel.Dock="Top"
          MouseDown="GrdImageView_MouseDown"
          SizeChanged="GrdImageView_SizeChanged">
        <Border Name="BorderImageView"
                Background="Transparent"
                ClipToBounds="True">
            <Grid Name="GrdDrawContainer"
                  MouseWheel="GrdDrawContainer_MouseWheel">
                <Image Name="ImageHost"
                       Stretch="None"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <drawingLib:DrawingCanvas x:Name="OverlayCanvas"></drawingLib:DrawingCanvas>
            </Grid>
        </Border>
    </Grid>
</UserControl>
