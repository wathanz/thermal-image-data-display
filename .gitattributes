# Normalize line endings across platforms; let Git detect text files automatically
* text=auto

# Use CRLF only for Windows-specific files
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf
*.sln    text eol=crlf
*.csproj text eol=crlf
image/demo.mp4 filter=lfs diff=lfs merge=lfs -text
