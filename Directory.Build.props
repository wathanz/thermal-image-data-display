<Project>
  <PropertyGroup>
    <CSharpLangVersion>10</CSharpLangVersion>
    <MajorMinorVersion>1.0</MajorMinorVersion>
    <!-- BuildNumber is passed in by CI (-p:BuildNumber=$env:GITHUB_RUN_NUMBER); defaults to 0 for local builds -->
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <VersionPrefix>$(MajorMinorVersion).$(BuildNumber)</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
    <Version>$(VersionPrefix)-$(VersionSuffix)</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <AssemblyVersion>$(MajorMinorVersion).0.0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <SystemDrawingCommonVersion>7.0.0</SystemDrawingCommonVersion>
    <SystemTextJsonVersion>9.0.1</SystemTextJsonVersion>
    
    <MicrosoftExtensionsDependencyInjectionVersion>8.0.0</MicrosoftExtensionsDependencyInjectionVersion>
    <MicrosoftExtensionsHostingVersion>8.0.0</MicrosoftExtensionsHostingVersion>
    <OpenCvSharpVersion>4.10.0.20240616</OpenCvSharpVersion>
</PropertyGroup>

  <!-- Opt-in CI quality policy: -p:QualityBaseline=true reports analyzer findings; -p:QualityGate=true also fails the build on them. -->
  <PropertyGroup Condition="'$(QualityGate)' == 'true' or '$(QualityBaseline)' == 'true'">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>9.0-recommended</AnalysisLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(QualityGate)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Opt-in NuGet audit policy: -p:DependencyAudit=true. Low/moderate stay warnings; high/critical and audit/source failures become errors. -->
  <PropertyGroup Condition="'$(DependencyAudit)' == 'true'">
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904;NU1900;NU1905;NU1801</WarningsAsErrors>
  </PropertyGroup>
</Project>